{
  "name": "shapeviz-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "start": "node --env-file-if-exists=.env server.js --production",
    "build": "node scripts/build.js",
    "icons:validate": "node scripts/validate-ui-icons.js",
    "presentations:validate": "node scripts/validate-presentations.js",
    "research:validate": "node scripts/validate-research.js",
    "research:schema": "node scripts/research-schema.js",
    "mcp:check": "node scripts/check-mcp-deployment.js",
    "presentation:new": "node scripts/new-presentation.js",
    "presentation:publish": "node --env-file-if-exists=.env scripts/publish-presentation.js",
    "presentation:create:template": "node --env-file-if-exists=.env scripts/create-template-presentation.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "editor:build": "node scripts/build-article-editor.js",
    "predev": "npm run editor:build",
    "pretest:browser": "npm run editor:build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "6.5.438",
    "sharp": "^0.35.4",
    "supabase": "^2.117.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "megajs": "1.3.10",
    "nodemailer": "10.0.10",
    "parse5": "8.0.1",
    "pdfkit": "0.20.2"
  }
}
