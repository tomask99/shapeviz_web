{
  "name": "shapeviz-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.js",
    "start": "node --env-file-if-exists=.env server.js --production",
    "build": "node scripts/build.js",
    "presentations:validate": "node scripts/validate-presentations.js",
    "presentation:new": "node scripts/new-presentation.js",
    "presentation:import:milenium": "node scripts/import-milenium.js",
    "presentation:publish": "node --env-file-if-exists=.env scripts/publish-presentation.js",
    "presentation:create:template": "node --env-file-if-exists=.env scripts/create-template-presentation.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "sharp": "^0.35.4",
    "supabase": "^2.117.0"
  }
}
