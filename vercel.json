{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "functions": {
    "api/files.js": {"maxDuration": 60},
    "api/mcp.js": {"maxDuration": 60},
    "api/contact.js": {
      "maxDuration": 60
    },
    "api/site-events.js": {
      "includeFiles": "public/{index.html,shop/index.html}",
      "maxDuration": 30
    },
    "api/admin.js": {
      "includeFiles": "presentation-templates/**",
      "maxDuration": 60
    },
    "api/presentation-events.js": {
      "maxDuration": 30,
      "includeFiles": "presentations/*/project.json"
    },
    "api/presentation-page.js": {
      "includeFiles": "{presentation-templates,build/presentation-bundles}/**"
    }
  },
  "redirects": [
    {"source":"/articles/","destination":"/articles","permanent":true},
    {"source":"/articles/:article([a-z0-9-]+)/","destination":"/articles/:article","permanent":true},
    {"source":"/sk/ochrana-osobnych-udajov","destination":"/sk/pravne-informacie","permanent":true},
    {"source":"/en/privacy","destination":"/en/legal","permanent":true},
    {"source":"/shop/:product([a-z0-9-]+)/","destination":"/shop/:product","permanent":true},
    {"source": "/index.html", "destination": "/", "permanent": true},
    {"source": "/shop/index.html", "destination": "/shop", "permanent": true},
    {"source": "/shop/", "destination": "/shop", "permanent": true},
    {"source": "/:locale(sk|en)/", "destination": "/:locale", "permanent": true},
    {"source": "/:locale(sk|en)/shop/", "destination": "/:locale/shop", "permanent": true},
    {"source": "/sk/sluzby/:service/", "destination": "/sk/sluzby/:service", "permanent": true},
    {"source": "/en/services/:service/", "destination": "/en/services/:service", "permanent": true},
    {
      "source": "/p/:slug/",
      "destination": "/p/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {"source":"/articles","destination":"/api/site-events?route=articles"},
    {"source":"/articles/:article([a-z0-9-]+)","destination":"/api/site-events?route=articles&article=:article"},
    {"source":"/sitemap-articles.xml","destination":"/api/site-events?route=articles-sitemap"},
    {"source":"/sk/pravne-informacie","destination":"/api/site-events?route=page&locale=sk&legal=legal"},
    {"source":"/sk/ochrana-osobnych-udajov","destination":"/api/site-events?route=page&locale=sk&legal=privacy"},
    {"source":"/en/legal","destination":"/api/site-events?route=page&locale=en&legal=legal"},
    {"source":"/en/privacy","destination":"/api/site-events?route=page&locale=en&legal=privacy"},
    {"source":"/sitemap-products.xml","destination":"/api/site-events?route=shop-sitemap"},
    {"source":"/shop/:product([a-z0-9-]+)","destination":"/api/site-events?route=product&product=:product"},
    {"source": "/sk/sluzby/:service", "destination": "/api/site-events?route=page&locale=sk&service=:service"},
    {"source": "/sk/sluzby/:service/", "destination": "/api/site-events?route=page&locale=sk&service=:service"},
    {"source": "/en/services/:service", "destination": "/api/site-events?route=page&locale=en&service=:service"},
    {"source": "/en/services/:service/", "destination": "/api/site-events?route=page&locale=en&service=:service"},
    {"source": "/", "destination": "/api/site-events?route=page"},
    {"source": "/index.html", "destination": "/api/site-events?route=page"},
    {"source": "/:locale(sk|en)", "destination": "/api/site-events?route=page&locale=:locale"},
    {"source": "/:locale(sk|en)/", "destination": "/api/site-events?route=page&locale=:locale"},
    {"source": "/:locale(sk|en)/shop", "destination": "/api/site-events?route=page&page=shop&locale=:locale"},
    {"source": "/:locale(sk|en)/shop/", "destination": "/api/site-events?route=page&page=shop&locale=:locale"},
    {"source": "/shop/index.html", "destination": "/api/site-events?route=page&page=shop"},
    {"source": "/admin/planner", "destination": "/admin/index.html"},
    {"source": "/api/shop", "destination": "/api/site-events?route=shop"},
    {"source": "/shop", "destination": "/api/site-events?route=page&page=shop"},
    {"source": "/shop/", "destination": "/api/site-events?route=page&page=shop"},
    {"source": "/admin/shop", "destination": "/admin/index.html"},
    {"source": "/admin/site-editing", "destination": "/admin/index.html"},
    {"source": "/admin/site-editing/", "destination": "/admin/index.html"},
    {"source": "/admin/cloud-storage", "destination": "/admin/index.html"},
    {"source": "/admin/projects", "destination": "/admin/index.html"},
    {"source": "/admin/time-tracker", "destination": "/admin/index.html"},
    {"source": "/files/share/:share([A-Za-z0-9_-]{32})", "destination": "/files/index.html"},
    {"source": "/files/:slug([a-z0-9]+(?:-[a-z0-9]+)*)", "destination": "/files/index.html"},
    {"source": "/oauth/authorize", "destination": "/api/oauth/authorize"},
    {"source": "/oauth/token", "destination": "/api/oauth/token"},
    {"source": "/oauth/revoke", "destination": "/api/oauth/revoke"},
    {"source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth/metadata"},
    {"source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth/resource"},
    {"source": "/.well-known/oauth-protected-resource/api/mcp", "destination": "/api/oauth/resource"},
    {"source": "/admin/connections", "destination": "/admin/connections.html"},
    {
      "source": "/admin/ai-research",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/ai-research/:id",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/reports",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/clients",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/clients/:id",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/follow-ups",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/pipeline",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/leads",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/leads/:id",
      "destination": "/admin/index.html"
    },
    {
      "source": "/adminlogin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/presentation-page?slug=:slug"
    }
  ],
  "headers": [
    {"source":"/shop/:path*","headers":[{"key":"Cache-Control","value":"no-store"},{"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self' https://gumroad.com https://assets.gumroad.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://public-files.gumroad.com https://assets.gumroad.com; connect-src 'self'; frame-src https://gumroad.com https://*.gumroad.com; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"}]},
    {
      "source": "/presentation-media/:path*",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=31536000, immutable"},
        {"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"},
        {"key":"X-Content-Type-Options","value":"nosniff"}
      ]
    },
    {
      "source": "/files/:path*",
      "headers": [
        {"key":"Cache-Control","value":"no-store"},
        {"key":"Referrer-Policy","value":"no-referrer"},
        {"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"},
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"X-Frame-Options","value":"DENY"},
        {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; media-src 'self' blob:; connect-src 'self' https://*.mega.co.nz https://*.mega.nz; worker-src 'self'; frame-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"}
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.supabase.co https://gumroad.com https://assets.gumroad.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co; frame-src 'self' blob: https://gumroad.com https://*.gumroad.com; img-src 'self' https://*.supabase.co data: blob:; media-src 'self' https://*.supabase.co blob:; font-src 'self' https://*.supabase.co data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/p/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/p/:slug/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/adminlogin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.supabase.co https://gumroad.com https://assets.gumroad.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co; frame-src 'self' blob: https://gumroad.com https://*.gumroad.com; img-src 'self' https://*.supabase.co data: blob:; media-src 'self' https://*.supabase.co blob:; font-src 'self' https://*.supabase.co data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
