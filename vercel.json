{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "functions": {
    "api/presentation-events.js": {
      "includeFiles": "presentations/*/project.json"
    },
    "api/presentation-page.js": {
      "includeFiles": "presentation-templates/**"
    }
  },
  "redirects": [
    {
      "source": "/p/:slug/",
      "destination": "/p/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/presentation-page?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/p/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/p/:slug/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
