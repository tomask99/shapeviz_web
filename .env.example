# Copy to .env and fill in privately. Never commit .env.
PORT=3000
HOST=127.0.0.1
# Set to the exact public origin for production (e.g. https://your-domain.com).
SITE_URL=
# Contact delivery: https://resend.com/docs/api-reference/emails/send-email
# Set CONTACT_PROVIDER=gmail to use Gmail SMTP instead of Resend (no fallback).
CONTACT_PROVIDER=
GMAIL_USER=
# Google app password, never your normal Google password. Server-side only.
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Use an address on a domain verified in your Resend account.
CONTACT_FROM_EMAIL=

# Presentation analytics and future protected delivery. Server-side only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Use the remote registry and Storage when running the local Node server.
PRESENTATIONS_REMOTE=false

# External read-only MCP OAuth. Leave disabled until the canonical HTTPS origin
# and the exact client callback from ChatGPT have been configured (stage 3C.2c).
MCP_OAUTH_ENABLED=false
# Dedicated 32-byte base64 key. Generate privately; never reuse Supabase keys.
MCP_OAUTH_ENCRYPTION_KEY=
# JSON array: [{"client_id":"shapeviz-chatgpt","name":"ChatGPT","redirect_uris":["<exact HTTPS callback shown by ChatGPT>"]}]
MCP_OAUTH_CLIENTS=
# Desktop clients can add application_type:"native" with a registered portless
# callback such as http://127.0.0.1/callback. Only the listener port may vary;
# HTTPS remains mandatory for the deployed server and for web client callbacks.
# Local test only: allows explicit HTTP loopback origins/callbacks; refused on Vercel.
MCP_OAUTH_ALLOW_LOOPBACK=false

# Telegram visit notifications (server-side only). Send /start to your bot first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
